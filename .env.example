# Copy this file to .env and fill in the values.
# Never commit .env (it is in .gitignore).

# --- Mode of operation ---
# True  - local development: SQLite, SSL/secure-cookies disabled,
#         static/media served by runserver, SECRET_KEY optional
# False - server: SQLite/Postgres via DATABASE_URL, HTTPS security enabled,
#         SECRET_KEY required (no fallback)
DEBUG=True

# Required when DEBUG=False. Locally a built-in dev key is used.
# Generate one, for example: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
#SECRET_KEY=

# --- Hosts / CSRF (comma-separated) ---
#ALLOWED_HOSTS=localhost,127.0.0.1
#CSRF_TRUSTED_ORIGINS=http://localhost:8000

# --- Database ---
# Locally SQLite by default (db.sqlite3).
# On the server - for example:
#DATABASE_URL=postgres://user:password@host:5432/dbname

# --- HTTPS behind a reverse-proxy (nginx) ---
# Works only when DEBUG=False. True by default.
# Set to False if SSL terminates at nginx and Django sees http.
#SECURE_SSL_REDIRECT=True

# --- libmagic (for python-magic, audio file validation) ---
# The system libmagic library is required:
#   Linux (Debian/Ubuntu): apt install libmagic1
#   NixOS (temporary for running): nix-shell -p file
#   macOS: brew install libmagic
#   Windows: pip install python-magic-bin

# --- Reverse-proxy (nginx) ---
# True if the application runs behind nginx: the client IP is taken from X-Real-IP
# (django-axes and django-ratelimit), X-Forwarded-Proto is considered trusted.
# nginx must overwrite these headers, gunicorn must not be
# directly accessible from the outside. False by default.
#BEHIND_PROXY=False
