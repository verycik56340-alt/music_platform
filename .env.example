# Скопіюйте цей файл у .env і заповніть значеннями.
# .env ніколи не комітьте (він у .gitignore).

# --- Режим роботи ---
# True  - локальна розробка: SQLite, SSL/secure-cookies вимкнені,
#         роздача static/media через runserver, SECRET_KEY можна не задавати
# False - сервер: SQLite/Postgres через DATABASE_URL, HTTPS-безпека ввімкнена,
#         SECRET_KEY обов'язковий (без фолбеку)
DEBUG=True

# Обов'язковий при DEBUG=False. Локально використовується вбудований dev-ключ.
# Генеруйте, наприклад: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
#SECRET_KEY=

# --- Хости / CSRF (через кому) ---
#ALLOWED_HOSTS=localhost,127.0.0.1
#CSRF_TRUSTED_ORIGINS=http://localhost:8000

# --- База даних ---
# Локально за замовчуванням SQLite (db.sqlite3).
# На сервері - наприклад:
#DATABASE_URL=postgres://user:password@host:5432/dbname

# --- HTTPS за reverse-proxy (nginx) ---
# Працює тільки при DEBUG=False. За замовчуванням True.
# Встановіть False, якщо SSL термінується на nginx і Django бачить http.
#SECURE_SSL_REDIRECT=True

# --- libmagic (для python-magic, валідація аудіофайлів) ---
# Потрібна системна бібліотека libmagic:
#   Linux (Debian/Ubuntu): apt install libmagic1
#   NixOS (тимчасово для запуску): nix-shell -p file
#   macOS: brew install libmagic
#   Windows: pip install python-magic-bin

# --- Reverse-proxy (nginx) ---
# True, если приложение стоит за nginx: IP клиента берётся из X-Real-IP
# (django-axes и django-ratelimit), X-Forwarded-Proto считается доверенным.
# nginx обязан перезаписывать эти заголовки, gunicorn не должен быть
# доступен снаружи напрямую. По умолчанию False.
#BEHIND_PROXY=False
